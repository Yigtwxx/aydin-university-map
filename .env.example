# Aydın Campus Map - template for .env (copy to .env and fill in). Safe to commit: no values.
# Never put real secrets in this file.

# ===========================================================================
# AI assistant (Phase 5)
# ===========================================================================
# console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=
# aistudio.google.com -> Get API key -> Create API key
GEMINI_API_KEY=

# ===========================================================================
# Database: Supabase (Phase 3)
# ===========================================================================
# Supabase dashboard -> your project -> Connect -> Method "Session pooler" -> URI
# (postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres).
# Used by `amap db migrate|load|api-role`. Not the "Direct connection" URI:
# that host is IPv6-only and unreachable from most networks and from Vercel.
DATABASE_POOLER_URL=
# Written by `amap db api-role` (least-privilege `amap_api` role, transaction
# pooler on port 6543). The API reads it; set the same value on the host.
AMAP_API_DATABASE_URL=
# Project Settings -> General -> Project ID (Reference ID)
SUPABASE_PROJECT_REF=
# The database password you chose when creating the project
SUPABASE_DB_PASSWORD=

# ===========================================================================
# Static assets: Cloudflare Pages (free *.pages.dev, no domain needed)
# Panoramas and 3D models are served from here.
# ===========================================================================
# dash.cloudflare.com -> any page, right sidebar -> "Account ID"
CLOUDFLARE_ACCOUNT_ID=
# My Profile -> API Tokens -> Create Token -> "Create Custom Token":
#   Permissions: Account / Cloudflare Pages / Edit   (nothing else)
CLOUDFLARE_API_TOKEN=
CF_PAGES_PROJECT=aydin-campus-assets

# ===========================================================================
# Public URLs (filled after the first deploy; local defaults below)
# ===========================================================================
ASSET_BASE_URL=
# Walking graph for the API: local file or https://<project>.pages.dev/graph.geojson
GRAPH_SOURCE=data/out/graph.geojson
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ===========================================================================
# Local pipeline tools
# ===========================================================================
AMAP_DATA_DIR=data
COLMAP_BIN=colmap
# Folder containing the OpenMVS 2.4.0 binaries (Phase 2 dense step)
OPENMVS_BIN=
